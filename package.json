{
  "name": "ardium-ui-icons",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "serve": "cd projects/playground && ng serve",
    "start-homepage": "ng serve --project=homepage --port=4242",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "find-issues": "cd scripts && node NODE-finder.js",
    "cleanup-icons": "cd scripts && node NODE-cleanuper.js",
    "verion-icons": "cd projects/icons && npm version",
    "to-angular": "rmdir /s /Q projects/icons/src/lib & cd scripts && node NODE-angular-components.js && cd ../projects/icons",
    "build-icons": "npm run to-angular && ng build --configuration=production && npm run build-sass && cd ../../scripts && node NODE-copy-scss.js",
    "build-publish": "npm run build-icons && cd dist/icons && npm publish && cd ../../"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.13",
    "@angular/common": "^18.2.13",
    "@angular/compiler": "^18.2.13",
    "@angular/core": "^18.2.13",
    "@angular/forms": "^18.2.13",
    "@angular/platform-browser": "^18.2.13",
    "@angular/platform-browser-dynamic": "^18.2.13",
    "@angular/router": "^18.2.13",
    "@ardium-ui/devkit": "^1.1.0",
    "rxjs": "~7.8.0",
    "sass": "^1.78.0",
    "simple-bool": "^3.0.1",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.19",
    "@angular/cli": "^18.2.19",
    "@angular/compiler-cli": "^18.2.13",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^18.2.1",
    "typescript": "~5.5.4"
  }
}
