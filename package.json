{
  "name": "ardium-ui-icons",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "serve": "cd projects/playground && ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "find-issues": "cd scripts && node NODE-finder.js",
    "cleanup-icons": "cd scripts && node NODE-cleanuper.js",
    "verion-icons": "cd projects/icons && npm version",
    "build-publish": "rmdir /s /Q dist & cd scripts && node NODE-angular-components.js && cd ../projects/icons && ng build --configuration=production && npm run build-sass && cd ../../scripts && node NODE-copy-scss.js && cd ../dist/icons && npm publish && cd ../../"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.0.0",
    "@angular/common": "^17.0.0",
    "@angular/compiler": "^17.0.0",
    "@angular/core": "^17.0.0",
    "@angular/forms": "^17.0.0",
    "@angular/platform-browser": "^17.0.0",
    "@angular/platform-browser-dynamic": "^17.0.0",
    "@angular/router": "^17.0.0",
    "@ardium-ui/devkit": "^1.1.0",
    "rxjs": "~7.8.0",
    "sass": "^1.78.0",
    "simple-bool": "^3.0.1",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.1.0",
    "@angular/cli": "^17.0.5",
    "@angular/compiler-cli": "^17.0.0",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^17.1.0",
    "typescript": "~5.2.2"
  }
}
